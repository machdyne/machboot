# machboot -- Machdyne Lakritz (ECP5-25F, CABGA256)
#
# Ball assignments from the Zeitlos tree's boards/lakritz_v0.lpf
# (zeitlos ede46a8), which has them from the board's schematic and
# KiCad netlist. Only the pins machboot uses are here.

BLOCK RESETPATHS;
BLOCK ASYNCPATHS;

LOCATE COMP "CLK_48" SITE "A7";
IOBUF PORT "CLK_48" IO_TYPE=LVCMOS33;
FREQUENCY PORT "CLK_48" 48.0 MHz;

LOCATE COMP "LED_B" SITE "A2";
IOBUF PORT "LED_B" IO_TYPE=LVCMOS33;

# DVI on the DDMI connector: pseudo-differential, the N ball follows.
LOCATE COMP "DDMI_CK_P" SITE "L1";
IOBUF PORT "DDMI_CK_P" IO_TYPE=LVCMOS33D DRIVE=4;
LOCATE COMP "DDMI_D0_P" SITE "M1";
IOBUF PORT "DDMI_D0_P" IO_TYPE=LVCMOS33D DRIVE=4;
LOCATE COMP "DDMI_D1_P" SITE "R2";
IOBUF PORT "DDMI_D1_P" IO_TYPE=LVCMOS33D DRIVE=4;
LOCATE COMP "DDMI_D2_P" SITE "R4";
IOBUF PORT "DDMI_D2_P" IO_TYPE=LVCMOS33D DRIVE=4;

# Configuration flash (its SCK is reached through USRMCLK).
LOCATE COMP "CSPI_SS_FLASH" SITE "N8";
IOBUF PORT "CSPI_SS_FLASH" IO_TYPE=LVCMOS33;
LOCATE COMP "CSPI_MISO" SITE "T7";
IOBUF PORT "CSPI_MISO" IO_TYPE=LVCMOS33;
LOCATE COMP "CSPI_MOSI" SITE "T8";
IOBUF PORT "CSPI_MOSI" IO_TYPE=LVCMOS33;

# SD card (SPI mode; DAT1/DAT2 at F1/K3 are not used).
LOCATE COMP "SD_SCK" SITE "F2";
IOBUF PORT "SD_SCK" IO_TYPE=LVCMOS33 PULLMODE=NONE;
LOCATE COMP "SD_MOSI" SITE "K1";
IOBUF PORT "SD_MOSI" IO_TYPE=LVCMOS33 PULLMODE=NONE;
LOCATE COMP "SD_SS" SITE "K2";
IOBUF PORT "SD_SS" IO_TYPE=LVCMOS33 PULLMODE=NONE;
LOCATE COMP "SD_MISO" SITE "F3";
IOBUF PORT "SD_MISO" IO_TYPE=LVCMOS33 PULLMODE=UP;

# Serial console on PMOD A pins 2 and 3, as Zeitlos's UART0
# (a USB-UART PMOD; the same console is also on the USB-C port).
LOCATE COMP "UART0_TX" SITE "B12";
IOBUF PORT "UART0_TX" IO_TYPE=LVCMOS33;
LOCATE COMP "UART0_RX" SITE "B13";
IOBUF PORT "UART0_RX" IO_TYPE=LVCMOS33 PULLMODE=UP;

# USB host ports (keyboard).
LOCATE COMP "usb_host_dp[0]" SITE "A3";
IOBUF PORT "usb_host_dp[0]" IO_TYPE=LVCMOS33 PULLMODE=NONE;
LOCATE COMP "usb_host_dp[1]" SITE "B1";
IOBUF PORT "usb_host_dp[1]" IO_TYPE=LVCMOS33 PULLMODE=NONE;
LOCATE COMP "usb_host_dm[0]" SITE "A4";
IOBUF PORT "usb_host_dm[0]" IO_TYPE=LVCMOS33 PULLMODE=NONE;
LOCATE COMP "usb_host_dm[1]" SITE "B2";
IOBUF PORT "usb_host_dm[1]" IO_TYPE=LVCMOS33 PULLMODE=NONE;

# PROGRAMN, routed back to an I/O: pulling it reconfigures the FPGA.
LOCATE COMP "PROGRAMN" SITE "M8";
IOBUF PORT "PROGRAMN" IO_TYPE=LVCMOS33 OPENDRAIN=ON;

# USB device: the USB-C socket (Zeitlos boards/lakritz_v0.lpf). D+/D-
# through 22R; usb_ufp_pull switches the 1.5k pull-up on D+, driven
# high or released, never driven low (rtl/mb_soc.v).
LOCATE COMP "usb_ufp_dp" SITE "T6";
IOBUF PORT "usb_ufp_dp" IO_TYPE=LVCMOS33;
LOCATE COMP "usb_ufp_dm" SITE "R6";
IOBUF PORT "usb_ufp_dm" IO_TYPE=LVCMOS33;
LOCATE COMP "usb_ufp_pull" SITE "R7";
IOBUF PORT "usb_ufp_pull" IO_TYPE=LVCMOS33;
