# machboot: mozart ml2 (ML0 uses the ML1 file: the same balls on a 25F).
# The ports machboot uses, copied line for line from the Zeitlos tree's
# boards/mozart_ml2.lpf (from the carrier's and the module's netlists).

BLOCK RESETPATHS;
BLOCK ASYNCPATHS;
SYSCONFIG CONFIG_IOVOLTAGE=3.3 COMPRESS_CONFIG=ON MCCLK_FREQ=2.4 MASTER_SPI_PORT=DISABLE SLAVE_SPI_PORT=DISABLE SLAVE_PARALLEL_PORT=DISABLE CONFIG_MODE=SPI_SERIAL;
LOCATE COMP "CLK_48" SITE "C7";
IOBUF PORT "CLK_48" PULLMODE=NONE IO_TYPE=LVCMOS33;
FREQUENCY PORT "CLK_48" 48 MHZ;
LOCATE COMP "LED_B" SITE "T4";
IOBUF PORT "LED_B" IO_TYPE=LVCMOS33;
LOCATE COMP "CSPI_SS_FLASH" SITE "N8";
IOBUF PORT "CSPI_SS_FLASH" IO_TYPE=LVCMOS33;
LOCATE COMP "CSPI_MISO" SITE "T7";
IOBUF PORT "CSPI_MISO" IO_TYPE=LVCMOS33;
LOCATE COMP "CSPI_MOSI" SITE "T8";
IOBUF PORT "CSPI_MOSI" IO_TYPE=LVCMOS33;
LOCATE COMP "UART0_TX" SITE "B3";
IOBUF PORT "UART0_TX" IO_TYPE=LVCMOS33;
LOCATE COMP "UART0_RX" SITE "A2";
IOBUF PORT "UART0_RX" IO_TYPE=LVCMOS33;
LOCATE COMP "SD_SCK" SITE "L1";
IOBUF PORT "SD_SCK" IO_TYPE=LVCMOS33 PULLMODE=NONE;
LOCATE COMP "SD_MOSI" SITE "L4";
IOBUF PORT "SD_MOSI" IO_TYPE=LVCMOS33 PULLMODE=NONE;
LOCATE COMP "SD_SS" SITE "L2";
IOBUF PORT "SD_SS" IO_TYPE=LVCMOS33 PULLMODE=NONE;
LOCATE COMP "SD_MISO" SITE "L3";
IOBUF PORT "SD_MISO" IO_TYPE=LVCMOS33 PULLMODE=NONE;
LOCATE COMP "usb_host_dp[0]" SITE "A5";
IOBUF PORT "usb_host_dp[0]" IO_TYPE=LVCMOS33 PULLMODE=NONE;
LOCATE COMP "usb_host_dm[0]" SITE "A6";
IOBUF PORT "usb_host_dm[0]" IO_TYPE=LVCMOS33 PULLMODE=NONE;
LOCATE COMP "usb_host_dp[1]" SITE "A3";
IOBUF PORT "usb_host_dp[1]" IO_TYPE=LVCMOS33 PULLMODE=NONE;
LOCATE COMP "usb_host_dm[1]" SITE "A4";
IOBUF PORT "usb_host_dm[1]" IO_TYPE=LVCMOS33 PULLMODE=NONE;
LOCATE COMP "DDMI_CK_P" SITE "B10";
IOBUF PORT "DDMI_CK_P" IO_TYPE=LVCMOS33D;
IOBUF PORT "DDMI_CK_P" DRIVE=4;
LOCATE COMP "DDMI_D0_P" SITE "A9";
IOBUF PORT "DDMI_D0_P" IO_TYPE=LVCMOS33D;
IOBUF PORT "DDMI_D0_P" DRIVE=4;
LOCATE COMP "DDMI_D1_P" SITE "C8";
IOBUF PORT "DDMI_D1_P" IO_TYPE=LVCMOS33D;
IOBUF PORT "DDMI_D1_P" DRIVE=4;
LOCATE COMP "DDMI_D2_P" SITE "A11";
IOBUF PORT "DDMI_D2_P" IO_TYPE=LVCMOS33D;
IOBUF PORT "DDMI_D2_P" DRIVE=4;
LOCATE COMP "PROGRAMN" SITE "M8";
IOBUF PORT "PROGRAMN" IO_TYPE=LVCMOS33 OPENDRAIN=ON;

# The XA-XD link to the RP2040 (docs/xlink.md). Balls from the module's PCB
# (github.com/machdyne/sechzig, pcb/ml2_v0, the FPGA's pad nets /XA../XD).
LOCATE COMP "XA" SITE "N1";
IOBUF PORT "XA" IO_TYPE=LVCMOS33 PULLMODE=UP;
LOCATE COMP "XB" SITE "P1";
IOBUF PORT "XB" IO_TYPE=LVCMOS33 PULLMODE=UP;
LOCATE COMP "XC" SITE "R1";
IOBUF PORT "XC" IO_TYPE=LVCMOS33;
LOCATE COMP "XD" SITE "R2";
IOBUF PORT "XD" IO_TYPE=LVCMOS33 PULLMODE=UP;

# ML2's DDR3: machboot holds it in reset (rtl/top_sechzig.v, MB_DDR3_PARK).
# Balls and I/O type as Mach86's boards/sergei_ml2.lpf (the bank is 1.35 V).
LOCATE COMP "ddr3_reset_n" SITE "R12";
IOBUF PORT "ddr3_reset_n" IO_TYPE=SSTL135_I SLEWRATE=FAST;
LOCATE COMP "ddr3_cke" SITE "K12";
IOBUF PORT "ddr3_cke" IO_TYPE=SSTL135_I SLEWRATE=FAST;
